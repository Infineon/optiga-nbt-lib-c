root = true

[*]
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[LICENSES/*.txt]
max_line_length = unset
indent_size = unset

# handled with clang format
# [*.{c,cpp,cxx,h,hpp,hxx}]

# handled with CMake format
# [{CMakeLists.txt,*.cmake,*.cmake.in}]

[*.md]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = off
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off
